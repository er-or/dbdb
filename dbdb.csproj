<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>dbdb</AssemblyName>
    <RootNamespace>dbdb</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- Single-file self-contained publish settings -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

    <!-- Trimming: disabled because SqlClient reflection usage is not fully trim-safe -->
    <PublishTrimmed>false</PublishTrimmed>

    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- 100% managed MySQL driver - trim-safe -->
    <PackageReference Include="MySqlConnector" Version="2.*" />

    <!-- MS SQL Server driver -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.*" />

    <!-- SQLite driver (native sqlite3 bundled, extracted to temp at runtime) -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.*" />
  </ItemGroup>

</Project>
